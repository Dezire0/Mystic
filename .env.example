MYSTIC_DATA_DIR=./data
MYSTIC_DB_PATH=./data/mystic.sqlite3
MYSTIC_DEFAULT_PROVIDER=mock
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1/chat/completions
OPENAI_COMPATIBLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api/generate
VLLM_BASE_URL=http://localhost:8000/v1/chat/completions
# Phase 2D.2 specialist evaluation: server-side only; do not expose these in MCP/browser output.
# Wave 1 model IDs remain fixed in SpecialistModelRegistry, not request/environment-selected.
MYSTIC_NVIDIA_NIM_EXECUTION_ENABLED=false
MYSTIC_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com
MYSTIC_NVIDIA_NIM_API_KEY=YOUR_NVIDIA_NIM_API_KEY
MYSTIC_NVIDIA_NIM_TIMEOUT_SECONDS=30
MYSTIC_DISCORD_TOKEN=
MYSTIC_DISCORD_GUILD_ID=
